# Haasteen hinta ja saatavuus. Ilman avainta käytetään simulaatiota.
VALIO_API_KEY=
VALIO_API_BASE=https://junction26.valioaimo.fi
# Jos rajapinta ei vastaa, käytetään jo saatuja oikeita hintoja ja saatavuuksia (ei massahakua, ei keksittyjä hintoja).
# VALIO_FALLBACK=last-known
# Viimeisimmän tunnetun hinnan enimmäisikä tunteina (oletus 72). "none" = ei rajaa (demo suljetun testirajapinnan jälkeen).
# FALLBACK_PRICE_MAX_AGE_HOURS=none

# Vapaa keskustelu; ilman avainta käytetään sääntötulkkia.
ANTHROPIC_API_KEY=
DEEP_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
PORT=4747

# WhatsApp (docs/whatsapp.md): oma palvelin komennolla npm run whatsapp, tai sivuston sisällä WHATSAPP_ENABLED=true ja npm start.
# Samaa kantaa saa käsitellä vain yksi prosessi.
# WHATSAPP_ENABLED=true
WHATSAPP_PORT=4748
# Pakolliset kanavan tiedot Metan sovelluksesta: numerotunniste (Phone number ID), system user -token, App Secret, itse
# arvottu webhookin verify token, Graph API -versio ja ihmisen yhteystieto, jonka "tuki"-viesti antaa.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_SUPPORT_CONTACT=
# Kesken jäänyt ostoskori: näin monen minuutin tauon jälkeen apuri kysyy, lisätäänkö uusi viesti vanhaan koriin (oletus 120, 0 = ei kysytä).
# WHATSAPP_STALE_CART_MINUTES=120
# Vastaukset lähettäjän tyyliin (server/whatsapp/voice.mjs): listat, hinnat ja vastaussanat pysyvät koodin omina. false = vakiotekstit.
# WHATSAPP_VOICE=true
# Lähekkäin tulleet viestit yhdeksi vuoroksi: odotus viimeisestä viestistä ja enimmäisodotus millisekunteina (0 = ei niputusta
# eikä vanhentuneen vastauksen uusintaa).
# WHATSAPP_GATHER_MS=6000
# WHATSAPP_GATHER_MAX_MS=20000

# Tilausapuri v2 (docs/agent-v2.md): Claude-agentti työkaluilla vastaa WhatsAppissa ja selainkeskustelussa. Ilman asetusta
# vanha putki. Korisivu, tarjous ja maksu toimivat ennallaan. Tarvitsee ANTHROPIC_API_KEY:n. Transkripti tallentuu luonnoskantaan.
# WHATSAPP_AGENT=v2
# WHATSAPP_AGENT_MODEL=claude-sonnet-5-5   # claude-sonnet-5-5 (oletus) | claude-opus-5-5 | claude-haiku-5-5
# WHATSAPP_AGENT_EFFORT=medium           # low | medium | high | xhigh | max
# Kirjoitusvirheiden oikoluku valmiille vastaukselle (server/agent/proofread.mjs): vain virheelliset sanat vaihtuvat, ei lukuja,
# hintoja, tuotenimiä eikä linkkejä. Lisää vastaukseen noin 2 s. false = pois.
# WHATSAPP_AGENT_PROOFREAD=true
# WHATSAPP_AGENT_PROOFREAD_MODEL=claude-sonnet-5-5

# Tilauspolku tarvitsee katalogin ja omat, pysyvät kannat. Katso docs/whatsapp.md.
# WHATSAPP_ORDERING_ENABLED=true
# WHATSAPP_DB=/absolute/path/whatsapp/inbox.db
# WHATSAPP_DRAFT_DB=/absolute/path/whatsapp/drafts.db
# WHATSAPP_QUOTE_DB=/absolute/path/whatsapp/quotes.db
# GATEWAY_DB=/absolute/path/whatsapp/gateway.db
# AIMO_DB=/absolute/path/whatsapp/prices.db
# WHATSAPP_PUBLIC_URL=https://your-whatsapp-origin.example
# WHATSAPP_DEMO_PHONE=
# WHATSAPP_DEMO_PERSON=
# Kuvat ja ääniviestit tilaustilassa, ks. docs/whatsapp.md. Kuvat luetaan ANTHROPIC_API_KEY:llä; WHATSAPP_MEDIA=false ottaa
# molemmat pois. Ääniviestit tarvitsevat erikseen valitun litterointipalvelun; oletus none pyytää asiakasta kirjoittamaan.
# WHATSAPP_MEDIA=true
# WHATSAPP_TRANSCRIBE=none   # none | groq | openai | command
# GROQ_API_KEY=
# OPENAI_API_KEY=
# WHATSAPP_TRANSCRIBE_MODEL=
# WHATSAPP_TRANSCRIBE_COMMAND=/absolute/path/to/whisper-wrapper

# Valinnainen demomaksun julkinen alkuperä, ilman polkua.
# CLOUDFLARE_DEMO_URL=https://your-demo-origin.example

# Gatewayn demokello ja allekirjoitusavain. Tyhjä avain luodaan data/-kansioon.
# DEMO_NOW=2026-11-14T10:00:00+02:00
# Jatkuvasti päällä olevaan demoon jäädytettyä testirajapintaa vasten: kello kiertää DEMO_NOW:sta ja palaa alkuun
# tämän minuuttimäärän välein, joten su 15.11. klo 17.00 tilausaikaraja ei ylity (9.00 + 420 min = su 9–16).
# DEMO_NOW_LOOP_MINUTES=420
# GATEWAY_PRIVATE_KEY_PEM=
